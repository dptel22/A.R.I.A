# A.R.I.A. Environment Configuration Template
# Copy this to .env and fill in your own values:
#   cp .env.example .env

ARIA_API_KEY=__REPLACE_WITH_SECRET__
ARIA_DB_PATH=./runtime/db/aria.db
ARIA_MODEL_PATH=./models/aria_stage1.pt
ARIA_MODEL_RELEASE_URL=https://github.com/dptel22/A.R.I.A/releases/latest/download/aria_stage1.pt
ARIA_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:5173
ARIA_UPLOAD_DIR=./runtime/uploads

# ---------------------------------------------------------------------------
# Authority / jurisdiction configuration
# ---------------------------------------------------------------------------
# BBMP was dissolved 2 September 2025. The GBA (Greater Bengaluru Authority)
# now oversees five new city corporations. Set the correct corporation for
# the demo / deployment zone. Valid corporation names:
#   Bengaluru North Corporation
#   Bengaluru South Corporation
#   Bengaluru East Corporation
#   Bengaluru West Corporation
#   Bengaluru Central Corporation
ARIA_APEX_AUTHORITY=Greater Bengaluru Authority (GBA)
ARIA_CORPORATION_NAME=Bengaluru South Corporation
ARIA_DIVISION_NAME=Roads & Infrastructure Division

# ---------------------------------------------------------------------------
# Contract assistant (RAG)
# ---------------------------------------------------------------------------
# Required for document ingestion (embeddings) and grounded answers. Without
# it, document upload/ask degrade to 503 while all other endpoints keep working.
GEMINI_API_KEY=__REPLACE_WITH_GOOGLE_AI_STUDIO_KEY__
ARIA_GEMINI_MODEL=gemini-2.5-flash
ARIA_EMBEDDING_MODEL=gemini-embedding-001
ARIA_RAG_MAX_UPLOAD_MB=20
